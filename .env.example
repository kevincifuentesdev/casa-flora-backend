# ---- Server -------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Set to true when the API runs behind a reverse proxy / load balancer
TRUST_PROXY=false

# ---- Database -----------------------------------------------------------
DATABASE_URL=postgresql://casaflora:casaflora@localhost:5432/casaflora?schema=public

# ---- Better Auth --------------------------------------------------------
# Public URL of this API
BETTER_AUTH_URL=http://localhost:4000
# Generate one with: openssl rand -base64 48
BETTER_AUTH_SECRET=change-me-use-a-long-random-string-of-at-least-32-chars
# Only needed to share the session cookie between subdomains (e.g. .casaflora.co)
# COOKIE_DOMAIN=.casaflora.co

# ---- CORS ---------------------------------------------------------------
# Comma separated list of frontend origins
CORS_ORIGINS=http://localhost:3000

# ---- JWT (issued by Better Auth's jwt plugin) ----------------------------
JWT_AUDIENCE=casa-flora
JWT_EXPIRES_IN=15m

# ---- Restaurant capacity (seats per service slot) -------------------------
INTERIOR_CAPACITY=40
PATIO_CAPACITY=24
